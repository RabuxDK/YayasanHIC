---
/**
 * Footer situs: identitas, tautan program, dan kontak sekretariat resmi.
 */

import { getHicContent } from '../../services/hicCms';

const { site, rumahQuran, sahabatHic } = await getHicContent();

const year = new Date().getFullYear();
const waHref = `https://wa.me/${site.contact.waNumber}?text=${encodeURIComponent(
  `Assalamualaikum, saya ingin bertanya tentang ${site.name}.`,
)}`;
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="footer-logo">
          <img src={site.logo} width="40" height="40" alt="" />
        </span>
        <p>{site.footerSummary}</p>
      </div>

      <div>
        <h2 class="footer-title">Program</h2>
        <ul class="footer-list">
          <li><a href="/program#rumah-quran">{rumahQuran.shortName}</a></li>
          <li><a href="/program#sahabat-hic">{sahabatHic.shortName}</a></li>
          <li><a href="/psb">Penerimaan santri</a></li>
        </ul>
      </div>

      <div>
        <h2 class="footer-title">Halaman</h2>
        <ul class="footer-list">
          {site.nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-contact">
        <h2 class="footer-title">Sekretariat</h2>
        <p>{site.contact.address}</p>
        <a href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp {site.contact.whatsapp}</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} {site.name}</p>
      <a href="#atas">Kembali ke atas</a>
    </div>
  </div>
</footer>
