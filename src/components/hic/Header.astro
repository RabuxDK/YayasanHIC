---
/**
 * Header situs: wordmark, navigasi utama, dan satu aksi utama.
 */

import { getHicContent } from '../../services/hicCms';

const { site } = await getHicContent();

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;
  const base = href.replace(/\/+$/, '') || '/';
  return base === '/' ? path === '/' : path === base || path.startsWith(`${base}/`);
};

const brandMain = site.name.replace(/^Yayasan\s+/i, '').trim() || site.name;
const brandSub = /^Yayasan\s+/i.test(site.name) ? 'Yayasan' : site.short;
---

<header class="site-header" id="atas">
  <div class="container header-bar">
    <a class="brand" href="/">
      <img src={site.logo} width="40" height="40" alt="" />
      <span class="brand-text">
        <span class="brand-name">{brandMain}</span>
        <span class="brand-sub">{brandSub}</span>
      </span>
    </a>

    <nav class="site-nav" id="navigasi" aria-label="Navigasi utama">
      <ul class="nav-list">
        {site.nav.map((item) => (
          <li>
            <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-mobile-cta">
        <a class="btn btn-solid" href="/psb">Daftar PSB</a>
      </div>
    </nav>

    <div class="header-actions">
      <a class="btn btn-solid header-cta" href="/psb">Daftar PSB</a>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="navigasi"
        aria-label="Buka menu navigasi"
      >
        <svg class="nav-icon-open" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M3 5h14M3 10h14M3 15h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <svg class="nav-icon-close" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <span class="nav-toggle-label">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const toggleLabel = toggle?.querySelector<HTMLSpanElement>('.nav-toggle-label');

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
      if (toggleLabel) toggleLabel.textContent = open ? 'Tutup' : 'Menu';
    };

    toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!header.hasAttribute('data-open')) return;
      const target = event.target as Node | null;
      if (target && !header.contains(target)) {
        setOpen(false);
      }
    });

    header.querySelectorAll<HTMLAnchorElement>('.nav-link, .nav-mobile-cta a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }
</script>
