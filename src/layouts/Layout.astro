---
/**
 * Layout induk situs Yayasan Hidayatul Ilmi Cendekia.
 * Memuat font, meta SEO, data terstruktur, dan gaya global.
 */

import '../styles/global.css';
import { site } from '../data/hic';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = `${site.name} | Rumah Qur\u2019an dan HIC Berbagi`,
  description = site.description,
  image = '/images/og-hic.jpg',
  canonicalUrl = new URL(Astro.url.pathname, site.url).href,
} = Astro.props;

const imageUrl = new URL(image, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: site.name,
  alternateName: site.short,
  description: site.description,
  url: site.url,
  logo: new URL('/images/logo-hic-320.png', site.url).href,
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#28378f" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/images/logo-hic-160.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      html,
      body {
        overflow-x: clip;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#konten">Lewati ke konten</a>
    <slot />
  </body>
</html>


