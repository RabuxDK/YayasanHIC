---
/**
 * Donasi: halaman trust-first penyaluran amanah dan konfirmasi donasi Sahabat Hidayatul Ilmi Cendekia.
 */

import '../styles/donasi-kontak.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/hic/Header.astro';
import Footer from '../components/hic/Footer.astro';
import { DonationForm } from '../components/islands/DonationForm';
import { getHicContent } from '../services/hicCms';

const { site, donation, sahabatHic } = await getHicContent();
const { heroTitle, trustTitle } = donation;
---

<Layout
  title={`Donasi ${sahabatHic.shortName} | ${site.name}`}
  description={`Penyaluran amanah dan formulir konfirmasi donasi untuk ${sahabatHic.name} dan Rumah Qur'an HIC.`}
>
  <Header />

  <main id="konten">
    <section class="page-hero on-dark">
      <div class="container">
        <div>
          <h1>{heroTitle}</h1>
          <p>{donation.heroSubtitle}</p>
          <div class="page-hero-actions">
            <a class="btn btn-solid btn-lg" href="#formulir-donasi">Isi konfirmasi donasi</a>
            <a class="btn btn-quiet btn-lg" href="#peruntukan">Peruntukan amanah</a>
          </div>
        </div>
        <figure>
          <img
            src={donation.heroImage}
            srcset={donation.heroImageSrcset}
            sizes="(max-width: 60rem) 100vw, 42vw"
            width="1280"
            height="720"
            alt={donation.heroImageAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="section" id="peruntukan" aria-labelledby="peruntukan-title">
      <div class="container">
        <div class="donasi-trust-grid">
          <div class="donasi-trust-intro">
            <h2 id="peruntukan-title">{trustTitle}</h2>
            <p>{donation.trustSubtitle}</p>
            <figure class="donasi-trust-figure">
              <img
                src={donation.trustImage}
                srcset={donation.trustImageSrcset}
                sizes="(max-width: 60rem) 100vw, 44vw"
                width="1280"
                height="960"
                alt={donation.trustImageAlt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{donation.trustCaption}</figcaption>
            </figure>
          </div>

          <ol class="donasi-channels">
            {donation.programs.map((item) => (
              <li class="donasi-channel-item">
                <div class="donasi-channel-body">
                  <h3>{item.label}</h3>
                  <p>{item.note}</p>
                  <a
                    class="donasi-channel-link"
                    href={`?program=${item.id}#formulir-donasi`}
                  >
                    Donasi {item.label}
                  </a>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="section section--soft dk-section-spacious" id="sasaran" aria-labelledby="sasaran-title">
      <div class="container">
        <div class="donasi-activity-grid">
          <div class="donasi-activity-aside">
            <h2 id="sasaran-title">Bentuk penyaluran</h2>
            <p>Penyaluran amanah oleh pengurus yayasan.</p>
            <div class="donasi-beneficiary-panel">
              <h3>Penerima manfaat</h3>
              <p>{sahabatHic.beneficiaries}</p>
            </div>
          </div>

          <ol class="donasi-activity-list">
            {sahabatHic.activities.map((activity) => (
              <li>{activity}</li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="section dk-section-xl" id="formulir-donasi" aria-labelledby="form-title">
      <div class="container">
        <div class="section-head">
          <h2 id="form-title">Formulir konfirmasi</h2>
          <p>Empat tahap konfirmasi donasi lewat WhatsApp.</p>
        </div>

        <div class="form-layout donasi-form-layout">
          <DonationForm
            client:load
            waNumber={site.contact.waNumber}
            programs={donation.programs}
            amounts={donation.amounts}
            methods={donation.methods}
          />

          <aside class="form-aside">
            <div class="donasi-flow-panel">
              <h3>Alur WhatsApp</h3>
              <ol class="donasi-flow-list">
                {donation.waFlow.map((step) => (
                  <li>
                    <div>
                      <strong>{step.title}</strong>
                      <span>{step.text}</span>
                    </div>
                  </li>
                ))}
              </ol>
              <a class="text-link" href="/kontak">Alamat sekretariat</a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
