---
/**
 * Beranda Yayasan Hidayatul Ilmi Cendekia: profil ringkas, sambutan, program, dokumentasi, kabar, prestasi, PSB, donasi, dan FAQ.
 * Seluruh konten dibaca dari RabuxID CMS melalui getHicContent() dengan fallback aman ke data resmi lokal.
 */

import Layout from '../layouts/Layout.astro';
import Header from '../components/hic/Header.astro';
import Footer from '../components/hic/Footer.astro';
import '../styles/artikel.css';
import { DonationQuick } from '../components/islands/DonationQuick';
import { getHicContent } from '../services/hicCms';

const {
  site,
  hero,
  profile,
  programsIntro,
  programs,
  synergy,
  homeGalleryStrip: strip,
  sambutan,
  artikelPage,
  articles,
  achievementsSection,
  achievements,
  psb,
  donation,
  faqSection,
  faq,
  posts: cmsPosts,
} = await getHicContent();

const formatDate = (iso: string) => {
  if (!iso) return '';
  const value = iso.includes('T') ? iso : `${iso}T00:00:00`;
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return '';
  return parsed.toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
};

const clampCopy = (value: string, maxLen: number) => {
  const clean = value.trim();
  if (clean.length <= maxLen) return clean;
  return `${clean.slice(0, maxLen).trimEnd()}\u2026`;
};

const editorialItems =
  cmsPosts.length > 0
    ? cmsPosts.slice(0, 4).map((post) => ({
        title: post.title,
        excerpt: post.excerpt ? clampCopy(post.excerpt, 120) : '',
        category: post.category || 'Artikel',
        date: post.publishedAt || '',
        author: post.authorName || site.short,
        href: `/${post.slug}`,
        ctaLabel: 'Baca artikel',
        image: post.coverImage || '/images/galeri-quran-800.jpg',
        imageAlt: post.title,
      }))
    : articles.slice(0, 4).map((article) => ({
        title: article.title,
        excerpt: article.excerpt,
        category: article.category,
        date: article.date,
        author: article.author,
        href: '/artikel',
        ctaLabel: 'Lihat arsip',
        image: article.image,
        imageAlt: article.imageAlt,
      }));

const leadStory = editorialItems[0];
const sideStories = editorialItems.slice(1, 4);

const hPre = hero.headlinePrefix;
const hMark = hero.headlineHighlight;
const hSuf = hero.headlineSuffix;
const cta1 = hero.primaryCta;
const cta2 = hero.secondaryCta;
const aboutTitle = profile.heroTitle;
const newsTitle = artikelPage.homeTitle;
const awardTitle = achievementsSection.title;
const donateTitle = donation.homeTitle;

const mosaicSizes = [
  '(max-width: 60rem) 100vw, 50vw',
  '(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 36vw',
  '(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 28vw',
  '(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 28vw',
  '(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 28vw',
  '(max-width: 60rem) 100vw, 84vw',
];
---

<Layout>
  <Header />

  <main id="konten">
    <section class="hero on-dark">
      <div class="container stage-inner">
        <div class="stage-copy">
          <h1>
            {hPre}{' '}
            <span class="mark">{hMark}</span>{' '}
            {hSuf}
          </h1>
          <p class="hero-lede">{hero.subheadline}</p>
          <div class="hero-actions">
            <a class="btn btn-solid btn-lg" href={cta1.href}>{cta1.label}</a>
            <a class="btn btn-quiet btn-lg" href={cta2.href}>{cta2.label}</a>
          </div>
          <p class="hero-note">{site.name}</p>
        </div>
        <figure class="hero-figure">
          <img
            src={hero.image}
            srcset={hero.imageSrcset}
            sizes="(max-width: 60rem) 100vw, 44vw"
            width="1280"
            height="1600"
            alt={hero.imageAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <div class="day-wrap">
      <div class="container">
        <section class="day-strip" aria-labelledby="semangat-title">
          <h2 class="day-title" id="semangat-title">Semangat {site.name}</h2>
          <div class="day-grid">
            {profile.pillars.map((item) => (
              <div class="day-item">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>

    <section class="section section--spacious" id="tentang" aria-labelledby="tentang-title">
      <div class="container">
        <div class="about-grid">
          <div class="photo-stack">
            <figure class="photo-main">
              <img
                src={profile.homePhotoMain}
                srcset={profile.homePhotoMainSrcset}
                sizes="(max-width: 60rem) 100vw, 48vw"
                width="1280"
                height="720"
                alt={profile.homePhotoMainAlt}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="photo-second">
              <img
                src={profile.homePhotoSecond}
                srcset={profile.homePhotoSecondSrcset}
                width="800"
                height="533"
                alt={profile.homePhotoSecondAlt}
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>

          <div class="about-copy">
            <h2 id="tentang-title">{aboutTitle}</h2>
            <p>{profile.paragraphs[0]}</p>
            <div class="about-card">
              <div class="about-card-row">
                <h3>Visi Yayasan HIC</h3>
                <p>{profile.vision}</p>
              </div>
            </div>
            <div>
              <a class="btn btn-quiet" href="/tentang">Profil dan 7 misi</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="sambutan" aria-labelledby="sambutan-title">
      <div class="container">
        <div class="sambutan-grid">
          <figure class="sambutan-photo">
            <img
              src={sambutan.photo}
              width={sambutan.photoWidth}
              height={sambutan.photoHeight}
              alt={sambutan.photoAlt}
              loading="lazy"
              decoding="async"
            />
          </figure>

          <div class="sambutan-copy">
            <h2 id="sambutan-title">{sambutan.title}</h2>
            {sambutan.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <div class="sambutan-sign">
              <p class="sambutan-name">{sambutan.name}</p>
              <p class="sambutan-role">{sambutan.role}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--soft" id="program" aria-labelledby="program-title">
      <div class="container">
        <div class="section-head">
          <h2 id="program-title">Program Unggulan Yayasan</h2>
          <p>{programsIntro}</p>
        </div>

        <div class="program-list">
          {programs.map((program, index) => (
            <article class:list={['program-card', index % 2 === 1 && 'program-card--flip']}>
              <figure class="program-card-media">
                <img
                  src={program.image}
                  width="640"
                  height="640"
                  alt={program.imageAlt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="program-card-body">
                <p class="program-tagline">{program.tagline}</p>
                <h3>{program.name}</h3>
                <p class="program-summary">{program.summary}</p>
                <ul class="program-points">
                  {program.points.map((point) => (
                    <li>
                      <strong>{point.title}.</strong> {point.text}
                    </li>
                  ))}
                </ul>
                <p class="program-meta">{program.meta}</p>
                <div class="program-actions">
                  <a class="btn btn-solid" href={program.action.href}>{program.action.label}</a>
                  <a class="btn btn-quiet" href={program.secondary.href}>Detail program</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--spacious" aria-labelledby="galeri-title">
      <div class="container">
        <div class="section-head section-head--row">
          <div>
            <h2 id="galeri-title">Dokumentasi kegiatan</h2>
            <p>Pembinaan Al-Qur&rsquo;an, kajian, dan penyaluran bantuan sosial.</p>
          </div>
          <a class="btn btn-quiet" href="/galeri">Lihat semua galeri</a>
        </div>

        <div class="gallery-mosaic">
          {strip.map((item, index) => (
            <figure class="gallery-mosaic-item">
              <img
                src={item.src}
                srcset={item.srcset}
                sizes={mosaicSizes[index] || '(max-width: 60rem) 100vw, 48vw'}
                width={item.width}
                height={item.height}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))}
        </div>

        <div class="wali-band on-dark">
          <div class="wali-band-copy">
            <h2 id="sinergi-title">{synergy.title}</h2>
            <p class="wali-band-lede">{synergy.subtitle}</p>
            <ul class="wali-band-list">
              {synergy.points.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="wali-band-actions">
              <a class="btn btn-solid" href="/kontak">Hubungi sekretariat</a>
              <a class="btn btn-quiet" href="/psb">Daftar santri baru</a>
            </div>
          </div>
          <figure class="wali-band-media">
            <img
              src={synergy.image}
              srcset={synergy.imageSrcset}
              sizes="(max-width: 60rem) 100vw, 48vw"
              width="1280"
              height="853"
              alt={synergy.imageAlt}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{synergy.imageCaption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section section--soft section--spacious" id="artikel-terbaru" aria-labelledby="artikel-title">
      <div class="container">
        <div class="section-head section-head--row">
          <div>
            <h2 id="artikel-title">{newsTitle}</h2>
            <p>{artikelPage.homeSubtitle}</p>
          </div>
          <a class="btn btn-quiet" href="/artikel">Semua artikel</a>
        </div>

        {leadStory && (
          <div class="editorial-feature">
            <article class="editorial-lead">
              <a class="editorial-media-link" href={leadStory.href} tabindex="-1" aria-hidden="true">
                <img
                  src={leadStory.image}
                  width="800"
                  height="500"
                  alt={leadStory.imageAlt}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="editorial-lead-body">
                <h3 class="editorial-lead-title">{leadStory.title}</h3>
                {leadStory.excerpt && <p class="editorial-lead-excerpt">{leadStory.excerpt}</p>}
                <div class="editorial-meta">
                  <span class="editorial-cat">{leadStory.category}</span>
                  {leadStory.date && <time datetime={leadStory.date}>{formatDate(leadStory.date)}</time>}
                  <span>{leadStory.author}</span>
                </div>
                <div class="editorial-actions">
                  <a
                    class="editorial-action-link"
                    href={leadStory.href}
                    aria-label={`${leadStory.ctaLabel}: ${leadStory.title}`}
                  >
                    <span>{leadStory.ctaLabel}</span>
                    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>

            {sideStories.length > 0 && (
              <ul class="editorial-index">
                {sideStories.map((item) => (
                  <li class="editorial-index-item">
                    <h3 class="editorial-index-title">{item.title}</h3>
                    {item.excerpt && <p class="editorial-index-excerpt">{item.excerpt}</p>}
                    <div class="editorial-meta">
                      <span class="editorial-cat">{item.category}</span>
                      {item.date && <time datetime={item.date}>{formatDate(item.date)}</time>}
                      <a
                        class="editorial-action-link"
                        href={item.href}
                        aria-label={`${item.ctaLabel}: ${item.title}`}
                      >
                        <span>{item.ctaLabel}</span>
                        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                          <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )}
      </div>
    </section>

    <section class="section section--spacious" id="prestasi" aria-labelledby="prestasi-title">
      <div class="container">
        <div class="section-head section-head--row">
          <div>
            <h2 id="prestasi-title">{awardTitle}</h2>
            <p>{achievementsSection.subtitle}</p>
          </div>
          <div class="carousel-actions">
            <a class="btn btn-quiet" href="/galeri">Lihat galeri</a>
            <div class="carousel-nav" role="group" aria-label="Navigasi galeri prestasi">
              <button
                class="carousel-btn"
                type="button"
                data-carousel-btn
                data-target="prestasi-track"
                data-dir="-1"
                aria-label="Prestasi sebelumnya"
              >
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button
                class="carousel-btn"
                type="button"
                data-carousel-btn
                data-target="prestasi-track"
                data-dir="1"
                aria-label="Prestasi berikutnya"
              >
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="carousel" id="prestasi-track" tabindex="0" aria-label="Galeri santri dan guru berprestasi">
          {achievements.map((item) => (
            <figure class="achieve-card">
              <img
                src={item.image}
                width={item.width}
                height={item.height}
                alt={item.imageAlt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="achieve-category">{item.category}</span>
                <strong>{item.title}</strong>
                <span>{item.detail}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <script>
      document.querySelectorAll('[data-carousel-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const track = document.getElementById(btn.getAttribute('data-target') || '');
          if (!track) return;
          const card = track.querySelector(':scope > *');
          const gap = 32;
          const step = card ? card.getBoundingClientRect().width + gap : 320;
          track.scrollBy({ left: Number(btn.getAttribute('data-dir') || 1) * step, behavior: 'smooth' });
        });
      });
    </script>

    <section class="section section--tight" aria-labelledby="psb-title">
      <div class="container">
        <div class="band on-dark">
          <div class="band-grid">
            <div>
              <h2 id="psb-title">{psb.homeTitle}</h2>
              <p>{psb.homeSubtitle}</p>
              <div class="band-actions">
                <a class="btn btn-solid btn-lg" href="/psb">Mulai pendaftaran</a>
              </div>
            </div>
            <ol class="steps">
              {psb.homeSteps.map((step) => (
                <li>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="donasi-title">
      <div class="container">
        <div class="band on-dark donate-band">
          <h2 id="donasi-title">{donateTitle}</h2>
          <p>{donation.homeSubtitle}</p>
          <DonationQuick client:visible amounts={donation.amounts} />
        </div>
      </div>
    </section>

    <section class="section section--soft" aria-labelledby="faq-title">
      <div class="container">
        <div class="section-head">
          <h2 id="faq-title">{faqSection.title}</h2>
        </div>
        <div class="faq-grid">
          <figure class="faq-figure">
            <img
              src={faqSection.image}
              srcset={faqSection.imageSrcset}
              sizes="(max-width: 60rem) 100vw, 34vw"
              width="1280"
              height="854"
              alt={faqSection.imageAlt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="faq-list">
            {faq.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
