---
/**
 * Beranda: hero, program, tentang, galeri, PSB, donasi, dan tanya jawab.
 */

import Layout from '../layouts/Layout.astro';
import Header from '../components/hic/Header.astro';
import Footer from '../components/hic/Footer.astro';
import { DonationQuick } from '../components/islands/DonationQuick';
import { site, programs, dayRhythm, ways, wali, gallery, faq, psb, donation, sambutan, articles, achievements } from '../data/hic';

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('id-ID', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });

const strip = [gallery[0], gallery[1], gallery[2], gallery[3], gallery[4], gallery[7]];

const mosaicSizes = [
  '(max-width: 60rem) 100vw, 50vw',
  '(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 36vw',
  '(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 28vw',
  '(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 28vw',
  '(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 28vw',
  '(max-width: 60rem) 100vw, 84vw',
];
---

<Layout>
  <Header />

  <main id="konten">
    <section class="hero on-dark">
      <div class="container stage-inner">
        <div class="stage-copy">
          <h1>Tempat anak tumbuh bersama <span class="mark">Al-Qur&rsquo;an</span></h1>
          <p class="hero-lede">Pembinaan bacaan, hafalan, dan adab dalam lingkungan yang tenang.</p>
          <div class="hero-actions">
            <a class="btn btn-solid btn-lg" href="/psb">Daftar santri baru</a>
            <a class="btn btn-quiet btn-lg" href="#program">Kenali program</a>
          </div>
          <p class="hero-note">Yayasan Hidayatul Ilmi Cendekia</p>
        </div>
        <figure class="hero-figure">
          <img
            src="/images/hero-mengaji-1400.jpg"
            srcset="/images/hero-mengaji-800.jpg 800w, /images/hero-mengaji-1400.jpg 1280w"
            sizes="(max-width: 60rem) 100vw, 44vw"
            width="1280"
            height="1600"
            alt="Santri membaca Al-Qur'an di musholla"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <div class="day-wrap">
      <div class="container">
        <section class="day-strip" aria-labelledby="hari-title">
          <h2 class="day-title" id="hari-title">Satu hari di Rumah Qur&rsquo;an</h2>
          <div class="day-grid">
            {dayRhythm.map((item) => (
              <div class="day-item">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>

    <section class="section" id="tentang" aria-labelledby="tentang-title">
      <div class="container">
        <div class="about-grid">
          <div class="photo-stack">
            <figure class="photo-main">
              <img
                src="/images/berbagi-santri-1400.jpg"
                srcset="/images/berbagi-santri-800.jpg 800w, /images/berbagi-santri-1400.jpg 1280w"
                sizes="(max-width: 60rem) 100vw, 48vw"
                width="1280"
                height="720"
                alt="Santri menerima bantuan pendidikan"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="photo-second">
              <img
                src="/images/hero-belajar-800.jpg"
                width="800"
                height="533"
                alt="Anak belajar membaca bersama guru"
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>

          <div class="about-copy">
            <h2 id="tentang-title">Tumbuh dari lingkungan belajar</h2>
            <p>
              HIC berawal dari halaqah kecil di musholla. Anak-anak datang selepas sekolah,
              membawa mushaf.
            </p>
            <p>
              Lalu bertambah: kelas tahsin, kajian wali, dan paket bantuan.
            </p>
            <div class="about-card">
              <div class="about-card-row">
                <h3>Visi</h3>
                <p>Dekat dengan Al-Qur&rsquo;an, berakhlak baik.</p>
              </div>
              <div class="about-card-row">
                <h3>Misi</h3>
                <p>Membina bacaan, mendampingi keluarga, menyalurkan bantuan.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="ways-grid">
          {ways.map((way) => (
            <div class="way">
              <h3>{way.title}</h3>
              <p>{way.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="sambutan" aria-labelledby="sambutan-title">
      <div class="container">
        <div class="sambutan-grid">
          <figure class="sambutan-photo">
            <img
              src={sambutan.photo}
              width={sambutan.photoWidth}
              height={sambutan.photoHeight}
              alt={sambutan.photoAlt}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <strong>{sambutan.name}</strong>
              <span>{sambutan.role}</span>
            </figcaption>
          </figure>

          <div class="sambutan-copy">
            <h2 id="sambutan-title">{sambutan.title}</h2>
            {sambutan.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <div class="sambutan-sign">
              <p class="sambutan-name">{sambutan.name}</p>
              <p class="sambutan-role">{sambutan.role}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--soft" id="program" aria-labelledby="program-title">
      <div class="container">
        <div class="section-head">
          <h2 id="program-title">Dua program, satu arah</h2>
          <p>
            Rumah Qur&rsquo;an membina, HIC Berbagi menopang. Keduanya berjalan bersama.
          </p>
        </div>

        <div class="program-list">
          {programs.map((program, index) => (
            <article class:list={['program-card', index % 2 === 1 && 'program-card--flip']}>
              <figure class="program-card-media">
                <img
                  src={program.image}
                  width="640"
                  height="640"
                  alt={program.imageAlt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="program-card-body">
                <p class="program-tagline">{program.tagline}</p>
                <h3>{program.name}</h3>
                <p class="program-summary">{program.summary}</p>
                <ul class="program-points">
                  {program.points.map((point) => (
                    <li>
                      <strong>{point.title}.</strong> {point.text}
                    </li>
                  ))}
                </ul>
                <p class="program-meta">
                  Untuk {program.audience} {program.note}
                </p>
                <div class="program-actions">
                  <a class="btn btn-solid" href={program.action.href}>{program.action.label}</a>
                  <a class="btn btn-quiet" href={program.secondary.href}>{program.secondary.label}</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="galeri-title">
      <div class="container">
        <div class="section-head section-head--row">
          <div>
            <h2 id="galeri-title">Dokumentasi kegiatan</h2>
            <p>Halaqah pagi, setoran hafalan, kelas tahsin, dan paket bantuan.</p>
          </div>
          <a class="btn btn-quiet" href="/galeri">Lihat semua galeri</a>
        </div>

        <div class="gallery-mosaic">
          {strip.map((item, index) => (
            <figure class="gallery-mosaic-item">
              <img
                src={item.src}
                srcset={item.srcset}
                sizes={mosaicSizes[index]}
                width={item.width}
                height={item.height}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))}
        </div>

        <div class="wali-band on-dark">
          <div class="wali-band-copy">
            <h2 id="wali-title">Bersama wali santri</h2>
            <p class="wali-band-lede">
              Orang tua ikut menjaga perjalanan belajar anak, bukan hanya menunggu hasil.
            </p>
            <ul class="wali-band-list">
              {wali.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="wali-band-actions">
              <a class="btn btn-solid" href="/kontak">Tanya sekretariat</a>
              <a class="btn btn-quiet" href="/psb">Daftar santri baru</a>
            </div>
          </div>
          <figure class="wali-band-media">
            <img
              src="/images/galeri-taklim-01-1400.jpg"
              srcset="/images/galeri-taklim-01-800.jpg 800w, /images/galeri-taklim-01-1400.jpg 1280w"
              sizes="(max-width: 60rem) 100vw, 48vw"
              width="1280"
              height="853"
              alt="Taklim ba'da maghrib di ruang utama"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Taklim ba&rsquo;da maghrib di ruang utama</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section section--soft" id="artikel-terbaru" aria-labelledby="artikel-title">
      <div class="container">
        <div class="section-head section-head--row">
          <div>
            <p class="section-eyebrow">Latest Article</p>
            <h2 id="artikel-title">Kabar dan artikel terbaru</h2>
            <p>Kegiatan, pengumuman, dan tulisan pembinaan dari pengurus dan guru.</p>
          </div>
          <div class="carousel-nav" role="group" aria-label="Navigasi artikel">
            <button class="carousel-btn" type="button" data-carousel-btn data-target="artikel-track" data-dir="-1" aria-label="Artikel sebelumnya">&larr;</button>
            <button class="carousel-btn" type="button" data-carousel-btn data-target="artikel-track" data-dir="1" aria-label="Artikel berikutnya">&rarr;</button>
          </div>
        </div>

        <div class="carousel" id="artikel-track" tabindex="0" aria-label="Daftar artikel terbaru">
          {articles.map((article) => (
            <article class="article-card">
              <div class="article-card-body">
                <div class="article-meta">
                  <time datetime={article.date}>{formatDate(article.date)}</time>
                  <span>{article.category}</span>
                </div>
                <h3>{article.title}</h3>
                <p class="article-author">Oleh {article.author}</p>
                <p class="article-excerpt">{article.excerpt}</p>
                <a class="btn btn-solid article-more" href="#artikel-terbaru">Read More</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="prestasi" aria-labelledby="prestasi-title">
      <div class="container">
        <div class="section-head section-head--row">
          <div>
            <p class="section-eyebrow">Gallery</p>
            <h2 id="prestasi-title">Galeri Santri dan Guru Berprestasi</h2>
            <p>Capaian santri dan guru yang kami syukuri bersama wali dan para donatur.</p>
          </div>
          <div class="carousel-actions">
            <a class="btn btn-quiet" href="/galeri">View All</a>
            <div class="carousel-nav" role="group" aria-label="Navigasi galeri prestasi">
              <button class="carousel-btn" type="button" data-carousel-btn data-target="prestasi-track" data-dir="-1" aria-label="Prestasi sebelumnya">&larr;</button>
              <button class="carousel-btn" type="button" data-carousel-btn data-target="prestasi-track" data-dir="1" aria-label="Prestasi berikutnya">&rarr;</button>
            </div>
          </div>
        </div>

        <div class="carousel" id="prestasi-track" tabindex="0" aria-label="Galeri santri dan guru berprestasi">
          {achievements.map((item) => (
            <figure class="achieve-card">
              <img
                src={item.image}
                width={item.width}
                height={item.height}
                alt={item.imageAlt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="achieve-category">{item.category}</span>
                <strong>{item.title}</strong>
                <span>{item.detail}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <script>
      document.querySelectorAll('[data-carousel-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const track = document.getElementById(btn.getAttribute('data-target') || '');
          if (!track) return;
          const card = track.querySelector(':scope > *');
          const gap = 32;
          const step = card ? card.getBoundingClientRect().width + gap : 320;
          track.scrollBy({ left: Number(btn.getAttribute('data-dir') || 1) * step, behavior: 'smooth' });
        });
      });
    </script>

    <section class="section section--tight" aria-labelledby="psb-title">
      <div class="container">
        <div class="band on-dark">
          <div class="band-grid">
            <div>
              <h2 id="psb-title">Penerimaan santri baru</h2>
              <p>Empat langkah, dari formulir sampai wawancara.</p>
              <div class="band-actions">
                <a class="btn btn-solid btn-lg" href="/psb">Mulai pendaftaran</a>
              </div>
            </div>
            <ol class="steps">
              <li>
                <div>
                  <h3>Isi formulir</h3>
                  <p>Data santri dan wali, dikirim lewat WhatsApp.</p>
                </div>
              </li>
              <li>
                <div>
                  <h3>Verifikasi</h3>
                  <p>Admin memeriksa kelengkapan dan menghubungi wali.</p>
                </div>
              </li>
              <li>
                <div>
                  <h3>Wawancara</h3>
                  <p>Pertemuan singkat untuk mengenal santri.</p>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="donasi-title">
      <div class="container">
        <div class="band on-dark donate-band">
          <h2 id="donasi-title">Dukung HIC Berbagi</h2>
          <p>Pilih nominal, kami kirim instruksi pembayaran lewat WhatsApp.</p>
          <DonationQuick client:visible amounts={donation.amounts} />
        </div>
      </div>
    </section>

    <section class="section section--soft" aria-labelledby="faq-title">
      <div class="container">
        <div class="section-head">
          <h2 id="faq-title">Pertanyaan yang sering diajukan</h2>
        </div>
        <div class="faq-grid">
          <figure class="faq-figure">
            <img
              src="/images/galeri-kajian-1400.jpg"
              srcset="/images/galeri-kajian-800.jpg 800w, /images/galeri-kajian-1400.jpg 1280w"
              sizes="(max-width: 60rem) 100vw, 34vw"
              width="1280"
              height="854"
              alt="Kajian bersama wali santri"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="faq-list">
            {faq.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
