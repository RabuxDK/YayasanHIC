---
/**
 * PSB: formulir penerimaan santri baru Rumah Qur'an Hidayatul Ilmi Cendekia.
 */

import Layout from '../layouts/Layout.astro';
import Header from '../components/hic/Header.astro';
import Footer from '../components/hic/Footer.astro';
import { PsbForm } from '../components/islands/PsbForm';
import { getHicContent } from '../services/hicCms';

const { site, psb, rumahQuran } = await getHicContent();

const waHref = `https://wa.me/${site.contact.waNumber}?text=${encodeURIComponent(
  `Assalamualaikum, saya ingin bertanya tentang penerimaan santri baru ${rumahQuran.name}.`,
)}`;
---

<Layout
  title={`${psb.title} | ${site.name}`}
  description={`Formulir penerimaan santri baru ${rumahQuran.name} di ${site.contact.addressShort}.`}
>
  <Header />

  <main id="konten">
    <section class="page-hero on-dark">
      <div class="container">
        <div>
          <h1>{psb.title}</h1>
          <p>{psb.heroSubtitle}</p>
        </div>
        <figure>
          <img
            src={psb.heroImage}
            srcset={psb.heroImageSrcset}
            sizes="(max-width: 60rem) 100vw, 40vw"
            width="1280"
            height="853"
            alt={psb.heroImageAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="section section--soft" aria-labelledby="form-title">
      <div class="container">
        <div class="section-head">
          <h2 id="form-title">{psb.formTitle}</h2>
          <p>{psb.formSubtitle}</p>
        </div>

        <div class="form-layout">
          <PsbForm
            client:load
            waNumber={site.contact.waNumber}
            steps={psb.steps}
            levels={psb.levels}
            schedules={psb.schedules}
            relations={psb.relations}
          />

          <aside class="form-aside">
            <div class="contact-block">
              <h3>Yang perlu disiapkan</h3>
              <ul class="aside-list">
                {psb.checklist.map((item) => (
                  <li>
                    <strong>{item.title}</strong>
                    <span>{item.text}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="contact-block">
              <h3>Butuh bantuan?</h3>
              <p>Hubungi sekretariat lewat WhatsApp {site.contact.whatsapp}.</p>
              <a class="btn btn-quiet" href={waHref} target="_blank" rel="noopener noreferrer">
                Tanya lewat WhatsApp
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
