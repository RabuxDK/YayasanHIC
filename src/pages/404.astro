---
/**
 * Halaman 404.
 */

import Layout from '../layouts/Layout.astro';
import Header from '../components/hic/Header.astro';
import Footer from '../components/hic/Footer.astro';
import { getHicContent } from '../services/hicCms';

const { site } = await getHicContent();
---

<Layout title={`Halaman tidak ditemukan | ${site.name}`}>
  <Header />
  <main id="konten" class="section">
    <div class="container">
      <h1>Halaman tidak ditemukan</h1>
      <p>Tautan yang Anda tuju mungkin sudah dipindahkan.</p>
      <div class="band-actions">
        <a class="btn btn-solid" href="/">Kembali ke beranda</a>
        <a class="btn btn-quiet" href="/program">Lihat program</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
