---
/**
 * Folder: src/pages/blog/
 * Description: Post archive for the site. Lists every published post from the RabuxID CMS,
 * newest first; the detail page lives at the root (src/pages/[slug].astro).
 * This file: index.astro
 */

import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { Navbar } from '../../components/islands/Navbar';
import { getCms, getField, getPosts } from '../../services/rabuxCms';

const cms = await getCms();
const posts = await getPosts();

const text = async (section: string, field: string) => {
  const value = await getField<string>(section, field);
  return typeof value === 'string' ? value : '';
};

const contact = {
  email: await text('contact', 'email'),
  phone: await text('contact', 'phone'),
  whatsapp: await text('contact', 'whatsapp'),
  address: await text('contact', 'address'),
  workingHours: await text('contact', 'working_hours'),
};
const story = await text('about', 'story');

const formatDate = (iso: string | null) =>
  iso
    ? new Date(iso).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' })
    : '';

const categories = Array.from(new Set(posts.map((post) => post.category).filter(Boolean))) as string[];
---

<Layout
  title={`Blog | ${cms.name}`}
  description={`Artikel, tips, dan kabar terbaru dari ${cms.name}.`}
  siteName={cms.name}
  canonicalUrl={Astro.url.href}
>
  <Navbar
    client:load
    siteName={cms.name}
    whatsapp={contact.whatsapp}
    phone={contact.phone}
  />

  <main class="bg-slate-950 text-slate-100">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-12 sm:pt-32">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-400">Blog</p>
      <h1 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
        Artikel &amp; kabar terbaru
      </h1>
      <p class="mt-4 max-w-2xl text-sm sm:text-base text-slate-400 leading-relaxed">
        Tulisan dari {cms.name} seputar produk, layanan, dan hal-hal yang kami anggap berguna untuk Anda.
      </p>

      {categories.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {categories.map((category) => (
            <span class="rounded-full border border-slate-800 bg-slate-900/60 px-3 py-1 text-xs text-slate-300">
              {category}
            </span>
          ))}
        </div>
      )}
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      {posts.length === 0 ? (
        <div class="rounded-3xl border border-slate-800 bg-slate-900/40 px-6 py-16 text-center">
          <h2 class="text-xl font-semibold text-white">Belum ada artikel</h2>
          <p class="mt-2 text-sm text-slate-400">
            Pos yang dipublikasikan dari panel RabuxID akan muncul di halaman ini.
          </p>
          <a
            href="/"
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-slate-950 transition-colors hover:bg-emerald-400"
          >
            Kembali ke beranda
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="group flex flex-col overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/40 transition-colors hover:border-emerald-500/50">
              <a href={`/${post.slug}`} class="block aspect-[16/9] overflow-hidden bg-slate-800">
                {post.coverImage ? (
                  <img
                    src={post.coverImage}
                    alt={post.title}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-slate-800 to-slate-900 text-2xl font-bold text-slate-600">
                    {post.title.charAt(0)}
                  </div>
                )}
              </a>

              <div class="flex flex-1 flex-col gap-3 p-5">
                <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
                  {post.category && (
                    <span class="rounded-full bg-emerald-500/10 px-2.5 py-0.5 font-semibold text-emerald-400">
                      {post.category}
                    </span>
                  )}
                  <time datetime={post.publishedAt || undefined}>{formatDate(post.publishedAt)}</time>
                </div>

                <h2 class="text-lg font-semibold leading-snug text-white">
                  <a href={`/${post.slug}`} class="transition-colors hover:text-emerald-400">
                    {post.title}
                  </a>
                </h2>

                {post.excerpt && (
                  <p class="line-clamp-3 text-sm leading-relaxed text-slate-400">{post.excerpt}</p>
                )}

                <div class="mt-auto flex items-center justify-between pt-2 text-xs text-slate-500">
                  <span>{post.readingTime > 0 ? `${post.readingTime} menit baca` : 'Artikel'}</span>
                  <a href={`/${post.slug}`} class="font-semibold text-emerald-400 hover:underline">
                    Baca selengkapnya
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  </main>

  <Footer siteName={cms.name} contact={contact} story={story} />
</Layout>
