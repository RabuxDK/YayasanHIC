---
/**
 * Folder: src/pages/
 * Description: Single post page at the site root (/<slug>). Content is CMS-authored HTML that the
 * RabuxID API sanitises before it is stored, so it can be rendered with set:html.
 * This file: [slug].astro
 */

import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { Navbar } from '../components/islands/Navbar';
import { getCms, getField, getPosts } from '../services/rabuxCms';
import type { CmsPost } from '../services/rabuxCms';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: CmsPost;
}

const { post } = Astro.props;
const cms = await getCms();

const text = async (section: string, field: string) => {
  const value = await getField<string>(section, field);
  return typeof value === 'string' ? value : '';
};

const contact = {
  email: await text('contact', 'email'),
  phone: await text('contact', 'phone'),
  whatsapp: await text('contact', 'whatsapp'),
  address: await text('contact', 'address'),
  workingHours: await text('contact', 'working_hours'),
};
const story = await text('about', 'story');

const publishedLabel = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('id-ID', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
    })
  : '';
const title = post.seoTitle || `${post.title} | ${cms.name}`;
const description = post.seoDescription || post.excerpt || '';
const socialImage = post.ogImage || post.coverImage || undefined;
---

<Layout
  title={title}
  description={description}
  image={socialImage}
  siteName={cms.name}
  canonicalUrl={Astro.url.href}
>
  <Navbar
    client:load
    siteName={cms.name}
    whatsapp={contact.whatsapp}
    phone={contact.phone}
  />

  <main class="bg-slate-950 text-slate-100">
    <article class="mx-auto max-w-3xl px-4 pt-28 pb-20 sm:px-6 sm:pt-32">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 transition-colors hover:text-emerald-300"
      >
        &larr; Semua artikel
      </a>

      <header class="mt-6 space-y-4">
        {post.category && (
          <span class="inline-flex rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-400">
            {post.category}
          </span>
        )}

        <h1 class="text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl">
          {post.title}
        </h1>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
          {publishedLabel && <time datetime={post.publishedAt || undefined}>{publishedLabel}</time>}
          {post.authorName && <span>{post.authorName}</span>}
          {post.readingTime > 0 && <span>{post.readingTime} menit baca</span>}
        </div>
      </header>

      {post.coverImage && (
        <div class="mt-8 overflow-hidden rounded-3xl border border-slate-800">
          <img src={post.coverImage} alt={post.title} class="w-full object-cover" />
        </div>
      )}

      <div class="post-body mt-10" set:html={post.content} />

      {post.tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2 border-t border-slate-800 pt-6">
          {post.tags.map((tag) => (
            <span class="rounded-full border border-slate-800 bg-slate-900/60 px-3 py-1 text-xs text-slate-400">
              {tag}
            </span>
          ))}
        </div>
      )}
    </article>
  </main>

  <Footer siteName={cms.name} contact={contact} story={story} />
</Layout>

<style>
  /* Post bodies are plain CMS HTML; these rules give it the site's reading rhythm. */
  .post-body {
    font-size: 1rem;
    line-height: 1.8;
    color: #cbd5e1;
  }

  .post-body > :global(* + *) {
    margin-top: 1.1em;
  }

  .post-body :global(h1),
  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    color: #ffffff;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .post-body :global(h1) {
    font-size: 1.9rem;
  }

  .post-body :global(h2) {
    font-size: 1.5rem;
  }

  .post-body :global(h3) {
    font-size: 1.2rem;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.4rem;
  }

  .post-body :global(ul) {
    list-style: disc;
  }

  .post-body :global(ol) {
    list-style: decimal;
  }

  .post-body :global(li + li) {
    margin-top: 0.4em;
  }

  .post-body :global(a) {
    color: #34d399;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body :global(strong) {
    color: #ffffff;
    font-weight: 700;
  }

  .post-body :global(blockquote) {
    border-left: 3px solid #10b981;
    padding-left: 1rem;
    color: #94a3b8;
    font-style: italic;
  }

  .post-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
    background-color: rgba(148, 163, 184, 0.15);
    padding: 0.1em 0.35em;
    border-radius: 0.35rem;
  }

  .post-body :global(pre) {
    overflow-x: auto;
    border-radius: 1rem;
    background-color: #0b1220;
    border: 1px solid #1e293b;
    padding: 1rem 1.15rem;
    font-size: 0.85rem;
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 1rem;
    border: 1px solid #1e293b;
  }

  .post-body :global(figcaption) {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: #64748b;
  }

  .post-body :global(hr) {
    border: 0;
    border-top: 1px solid #1e293b;
    margin: 2rem 0;
  }

  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .post-body :global(th),
  .post-body :global(td) {
    border: 1px solid #1e293b;
    padding: 0.5rem 0.7rem;
    text-align: left;
  }
</style>
