---
/**
 * Galeri: arsip editorial dokumentasi kegiatan Rumah Qur'an HIC, Sahabat HIC, dan prestasi.
 */

import Layout from '../layouts/Layout.astro';
import Header from '../components/hic/Header.astro';
import Footer from '../components/hic/Footer.astro';
import { GalleryShowcase, type ShowcaseItem } from '../components/islands/GalleryShowcase';
import { getHicContent } from '../services/hicCms';
import '../styles/galeri.css';

const { site, galleryPage, gallery, achievements } = await getHicContent();
const { heroTitle } = galleryPage;

const galleryItems: ShowcaseItem[] = gallery.map((item, idx) => ({
  id: `kegiatan-${idx + 1}`,
  src: item.src,
  highResSrc: item.highResSrc,
  srcset: item.srcset,
  alt: item.alt,
  title: item.caption,
  category: item.category,
  sublabel: item.category,
  detail: item.detail,
  width: item.width,
  height: item.height,
  orientation: item.orientation,
}));

const achievementItems: ShowcaseItem[] = achievements.map((item, idx) => ({
  id: `prestasi-${idx + 1}`,
  src: item.image,
  highResSrc: item.image,
  alt: item.imageAlt,
  title: item.title,
  category: 'Prestasi',
  sublabel: item.isPlaceholder ? `${item.category} (foto placeholder)` : item.category,
  detail: item.isPlaceholder
    ? `${item.detail} Dokumentasi saat ini memakai foto placeholder.`
    : item.detail,
  width: item.width,
  height: item.height,
  isPlaceholder: item.isPlaceholder,
  orientation: item.height > item.width ? 'portrait' : 'square',
}));

const showcaseItems: ShowcaseItem[] = [...galleryItems, ...achievementItems];

const waVisitHref = `https://wa.me/${site.contact.waNumber}?text=${encodeURIComponent(
  `Assalamualaikum ${site.name}, saya ingin menjadwalkan kunjungan ke sekretariat ${site.contact.addressShort}.`,
)}`;
---

<Layout
  title={`Galeri | ${site.name}`}
  description="Dokumentasi pembinaan Al-Qur'an, kajian wali santri, penyaluran bantuan Sahabat HIC, dan prestasi santri."
>
  <Header />

  <main id="konten">
    <section class="page-hero on-dark">
      <div class="container">
        <div>
          <h1>{heroTitle}</h1>
          <p>{galleryPage.heroSubtitle}</p>
          <div class="page-hero-actions">
            <a class="btn btn-solid btn-lg" href="#arsip-galeri">Lihat dokumentasi</a>
          </div>
        </div>
        <figure>
          <img
            src={galleryPage.heroImage}
            srcset={galleryPage.heroImageSrcset}
            sizes="(max-width: 60rem) 100vw, 42vw"
            width="1280"
            height="960"
            alt={galleryPage.heroImageAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="section galeri-showcase-sec" id="arsip-galeri" aria-labelledby="arsip-title">
      <div class="container">
        <div class="section-head">
          <h2 id="arsip-title">Arsip dokumentasi dan prestasi</h2>
          <p>Pilih kategori atau buka foto untuk melihat keterangan lengkap.</p>
        </div>

        <GalleryShowcase client:load items={showcaseItems} />
      </div>
    </section>

    <section
      class="section section--soft galeri-index-sec"
      id="lingkup-dokumentasi"
      aria-labelledby="lingkup-title"
    >
      <div class="container">
        <div class="galeri-index-layout">
          <div class="galeri-index-head">
            <h2 id="lingkup-title">Lingkup arsip</h2>
            <p>Dokumentasi kegiatan di {site.contact.addressShort}.</p>
          </div>

          <ol class="galeri-index-list">
            <li>
              <div>
                <h3>Pembinaan Al-Qur&rsquo;an</h3>
                <p>Halaqah, setoran hafalan, tahsin, pendampingan, dan murajaah.</p>
              </div>
            </li>
            <li>
              <div>
                <h3>Kajian dan Sahabat HIC</h3>
                <p>Kajian wali santri, taklim, serta penyaluran santunan.</p>
              </div>
            </li>
            <li>
              <div>
                <h3>Catatan foto prestasi</h3>
                <p>Kartu prestasi memakai foto placeholder sementara.</p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section section--tight galeri-cta-sec" aria-labelledby="kunjung-title">
      <div class="container">
        <div class="band on-dark">
          <div class="band-grid">
            <div>
              <h2 id="kunjung-title">Berkunjung ke sekretariat</h2>
              <p>
                Hubungi WhatsApp{' '}
                <a class="galeri-wa-link" href={waVisitHref} target="_blank" rel="noopener noreferrer">
                  {site.contact.whatsapp}
                </a>{' '}
                sebelum berkunjung ke {site.contact.addressShort}.
              </p>
            </div>
            <div class="band-actions">
              <a class="btn btn-solid btn-lg" href="/kontak">Hubungi sekretariat</a>
              <a class="btn btn-quiet btn-lg" href="/program">Lihat program</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
